@"
# Dependencies
node_modules/
backend/node_modules/

# Environment variables
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / build output
dist/
build/
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Database / dumps / local data
*.sql
*.dump
*.bak
*.sqlite
*.sqlite3
*.db

# Temporary files
tmp/
temp/
.cache/

# Large media files
*.mp4
*.mov
*.avi
*.mkv

# Archives
*.zip
"@ | Set-Content .gitignore